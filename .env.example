# Copy to .env and fill in. .env is gitignored — the whole project is about not
# leaking credentials, and losing one to a commit would be an unusually
# embarrassing way to fail.

# The model provider. This is the second door: inference does not go through TAP
# (see the README), so this key lives here rather than in the proxy.
LOCKED_LLM_KEY=

# TAP holds every other credential. Omit this and it is read from
# ~/.tap/agent.json, which is where the official helper puts it.
# TAP_API_KEY=

# --- Optional. Defaults shown. ---

# LOCKED_PROVIDER=kimi              # kimi | anthropic
# LOCKED_MODEL=k3                   # GET /v1/models on the provider lists these

# Which sandbox tier to run. `auto` takes the strongest one this machine can
# actually provide and falls back quietly; naming one explicitly makes its
# absence an error instead.
#   container   a container with no network interface   exec + files
#   workspace   a confined directory, nothing executes  files only
#   none        TAP is the entire surface
# LOCKED_SANDBOX=auto
# LOCKED_IMAGE=python:3.12-slim     # image for the container tier; needs Docker

# The context gauge asks the provider for its window. Override if it does not say.
# LOCKED_CONTEXT_WINDOW=

# Route inference through TAP as well, restoring the full invariant. It inherits
# TAP's 30-second ceiling, so it suits short turns only.
# LOCKED_LLM_VIA_TAP=1
# LOCKED_LLM_CREDENTIAL=kimi
